/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'NEXTCLADE_DATASETGET' {
        publishDir = [
            path: { "${params.outdir}/nextclade/datasets" },
            mode: params.publish_dir_mode,
            enabled: false
        ]
    }

    withName: 'NEXTCLADE_RUN' {
        publishDir = [
            path: { "${params.outdir}/nextclade/results" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'SPECIES_ASSIGN' {
        publishDir = [
            path: { "${params.outdir}/classification" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NEXTSTRAIN_EBOLA' {
        publishDir = [
            path: { "${params.outdir}/nextstrain_ebola" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'START_KNOWLEDGE_DB' {
        publishDir = [ enabled: false ]
    }

    withName: 'EXPORT_KNOWLEDGE_DB' {
        publishDir = [
            path: { "${params.outdir}/knowledge_warehouse" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'STOP_KNOWLEDGE_DB' {
        publishDir = [
            path: { "${params.outdir}/knowledge_warehouse" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_QUERY_PROTEINS' {
        publishDir = [
            path: { "${params.outdir}/phenotype_annotation/${meta.id}/query_data" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'UNIPROT_ANNOTATE' {
        publishDir = [
            path: { "${params.outdir}/phenotype_annotation/${meta.id}/uniprotr" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'UNIPROT_EXTRACTR_ANNOTATE' {
        publishDir = [
            path: { "${params.outdir}/phenotype_annotation/${meta.id}/uniprotextractr" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RBIOAPI_ANNOTATE' {
        publishDir = [
            path: { "${params.outdir}/phenotype_annotation/${meta.id}/rbioapi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FETCH_EPIDEMIOLOGICAL_DATA' {
        publishDir = [
            path: { "${params.outdir}/epidemiological_data/${meta.species ?: meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BUILD_KNOWLEDGE_DB' {
        publishDir = [
            path: { "${params.outdir}/knowledge_warehouse/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PATHOGEN_IDENTIFICATION' {
        publishDir = [
            path: { "${params.outdir}/pathogen_identification/${meta.species}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PATHOGEN_MUTATION_PROFILE' {
        publishDir = [
            path: { "${params.outdir}/pathogen_mutation_profile/${meta.species}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'MULTIQC' {
        errorStrategy = 'ignore'
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PREPARE_HMMDB' {
        storeDir = { params.hmm_db_cache_dir }
        publishDir = [ enabled: false ]
    }

    withName: 'HMM_ANNOTATE' {
        publishDir = [
            path: { "${params.outdir}/phenotype_annotation/${meta.id}/hmm" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAFFT_ALIGN' {
        ext.when   = { !params.skip_iqtree }
        ext.args   = { params.mafft_strategy }
        publishDir = [
            path: { "${params.outdir}/bioinformatics/${meta.id}/mafft" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'IQTREE2' {
        ext.when   = { !params.skip_iqtree }
        ext.args   = { "-m ${params.iqtree_model} ${params.iqtree_extra} -nt ${task.cpus}" }
        publishDir = [
            path: { "${params.outdir}/bioinformatics/${meta.id}/iqtree" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: 'LITERATURE_SEARCH' {
        publishDir = [
            path: { "${params.outdir}/literature_retrieval/literature_search/${meta.species}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PUBMED_METADATA' {
        publishDir = [
            path: { "${params.outdir}/literature_retrieval/literature_metadata/${meta.species}/${meta.domain}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'LITERATURE_DEDUPLICATE' {
        publishDir = [
            path: { "${params.outdir}/literature_retrieval/literature_deduplicated/${meta.species}/${meta.domain}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'LITERATURE_SCREEN' {
        publishDir = [
            path: { "${params.outdir}/literature_retrieval/literature_screened/${meta.species}/${meta.domain}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'LITERATURE_PDF' {
        publishDir = [
            path: { "${params.outdir}/literature_retrieval/literature_pdfs/${meta.species}/${meta.domain}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'LITERATURE_TEXT' {
        publishDir = [
            path: { "${params.outdir}/literature_retrieval/literature_text/${meta.species}/${meta.domain}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'LITERATURE_EVIDENCE' {
        publishDir = [
            path: { "${params.outdir}/literature_retrieval/literature_evidence/${meta.species}/${meta.domain}" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                filename.startsWith('evidence/') ? filename.substring(9) : filename
            }
        ]
    }

    withName: 'EVIDENCE_QC' {
        publishDir = [
            path: { "${params.outdir}/evidence_qc/${meta.species}/${meta.domain}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
