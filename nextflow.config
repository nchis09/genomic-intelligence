/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    pgirl/genomic-intelligence Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null
    fasta                      = null   // Direct path to query FASTA file (alternative to --input samplesheet)
    metadata                   = null   // Direct path to metadata TSV file (used with --fasta)

    // --- Genomic intelligence pipeline params ---
    // Representative screening panel (one or more datasets per pathogen/species).
    // Nextclade classifies input sequences against ALL of these and assigns
    // each sample to whichever dataset gives the best (lowest) qc.overallScore.
    nextclade_datasets         = [
        'nextstrain/orthoebolavirus/bdbv',
        'nextstrain/orthoebolavirus/ebov',
        'nextstrain/orthoebolavirus/sudv',
        'nextstrain/sars-cov-2/wuhan-hu-1/orfs',
        'nextstrain/flu/h1n1pdm/ha/MW626062',
        'nextstrain/flu/h3n2/ha/EPI1857216',
        'nextstrain/flu/vic/ha/KX058884',
        'nextstrain/mpox/all-clades',
        'nextstrain/dengue/all',
        'nextstrain/measles/genome/WHO-2012',
        'nextstrain/rsv/a/EPI_ISL_412866',
        'nextstrain/rsv/b/EPI_ISL_1653999',
        'nextstrain/yellow-fever/prM-E',
        'nextstrain/hmpv/all-clades/NC_039199',
        'nextstrain/wnv/all-lineages',
    ]
    query_samples              = null   // Comma-separated list of query sample names (auto-detected from FASTA if null)

    // --- Phenotype annotation params ---
    skip_phenotype_annotation  = false  // Set to true to skip UniProt phenotype annotation

    // --- HMM annotation params ---
    skip_hmm_annotation        = false  // Set to true to skip HMM annotation
    hmm_db_url                  = 'https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.gz'
    hmm_db_cache_dir            = "${projectDir}/database/hmmdb"
    hmm_evalue                 = 1e-5

    // --- Epidemiological data params ---
    skip_epi_data              = false  // Set to true to skip HDX epidemiological data download
    epi_search_term            = null   // Override the HDX disease search term (default: mapped from meta.pathogen)
    epi_hdx_rows               = 20     // Number of HDX datasets to consider

    // --- Literature search params ---
    skip_literature_search     = false  // Set to true to skip Europe PMC literature search
    literature_search_terms    = "${projectDir}/database/literature_search_terms.yml"
    literature_search_max_results = 200  // Max Europe PMC results per species per domain
    literature_search_mailto   = null   // Unused legacy OpenAlex argument
    literature_search_api_key  = null   // Unused legacy OpenAlex argument

    // --- PubMed metadata params ---
    skip_pubmed_metadata       = false  // Set to true to skip PubMed metadata fetch
    pubmed_email               = 'user@example.com'  // NCBI Entrez contact email (override with a real email)
    pubmed_batch_size          = 100    // Number of PMIDs to fetch per Entrez request
    pubmed_sleep               = 0.5    // Seconds to sleep between Entrez requests

    // --- Comparative genomics / ML tree params ---
    skip_iqtree                = false  // Set to true to skip MAFFT/IQ-TREE2
    mafft_strategy             = '--retree 2'  // MAFFT alignment options
    iqtree_model               = 'MFP'  // IQ-TREE2 substitution model
    iqtree_extra               = '-alrt 1000'  // Extra IQ-TREE2 flags

    // --- Knowledge warehouse params ---
    skip_knowledge_warehouse   = false  // Set to true to skip building the PostgreSQL knowledge warehouse
    // A single shared PostgreSQL instance is started once at pipeline launch
    // (START_KNOWLEDGE_DB) and stopped once the data has been ingested
    // (STOP_KNOWLEDGE_DB), so every species' BUILD_KNOWLEDGE_DB call can
    // write to the same live database.
    kw_db_host                 = '127.0.0.1'
    kw_db_port                 = 55432

    // References
    genome                     = null
    igenomes_base              = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore            = false

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = 'results'
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Keep intermediate work files inside the selected output directory per run
workDir = "${params.outdir}/work"

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        conda.cacheDir          = 'work/conda'
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load pgirl/genomic-intelligence custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load pgirl/genomic-intelligence custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/genomic-intelligence.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Load igenomes.config if required
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = false
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = false
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = false
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    // .mmd (raw Mermaid) instead of .html so the nf-metro completion step
    // (see PIPELINE_COMPLETION) can convert it into a metro-map diagram.
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.mmd"
}

manifest {
    name            = 'pgirl/genomic-intelligence'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'GOARN fellowship',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/pgirl/genomic-intelligence'
    description     = """Genomic Epidemic Intelligence System — multi-pathogen classification, phylogenetics, and evidence integration"""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

// The `genomes` map (loaded from conf/igenomes.config) is an internal lookup
// table, not a user-facing parameter -- exclude it from schema validation so
// nf-schema doesn't flag every nested iGenomes key as an invalid input.
validation {
    ignoreParams = ['genomes', 'skip_epi_data', 'epi_search_term', 'epi_hdx_rows', 'skip_literature_search', 'literature_search_terms', 'literature_search_max_results', 'literature_search_mailto', 'literature_search_api_key', 'skip_pubmed_metadata', 'pubmed_email', 'pubmed_batch_size', 'pubmed_sleep', 'skip_knowledge_warehouse', 'kw_db_host', 'kw_db_port', 'skip_hmm_annotation', 'hmm_db_url', 'hmm_db_cache_dir', 'hmm_evalue', 'skip_iqtree', 'mafft_strategy', 'iqtree_model', 'iqtree_extra']
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
